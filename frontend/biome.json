{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": { "includes": ["src/**", "!**/dist"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "useSemanticElements": "off" },
      "correctness": { "useExhaustiveDependencies": "off" },
      "suspicious": { "noExplicitAny": "error" },
      "style": { "useImportType": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" } },
  "css": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
